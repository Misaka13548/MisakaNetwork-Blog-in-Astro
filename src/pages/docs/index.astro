---
import { Button, Icon } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'
import PageLayout from '@/layouts/BaseLayout.astro'
import { integ } from '@/site-config'

import DocsContents from './DocsContents.astro'
import NotesContents from './NotesContents.astro'    /* attention 发生了修改  此处决定了向Docs页面添加主分类的方式，这里向Docs页面import了主分类组件NotesContents.astro */

const meta = {
  title: 'Docs',
  description: 'Docs content documentation'
}
---

<PageLayout {meta}>
  <Button title='Back' href='/' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-4xl font-extrabold'>Docs and Notes</h1>
    </div>

    <div id='content' class={cn('animate mt-8 max-w-none md:min-w-[45ch]', integ.typography.class)}>
      <h2 class='text-xl font-medium'>Notes</h2>
      <NotesContents title={false} horizontal />       {/* attention 发生了修改 */} {/* 上下顺序决定了网站主分类Notes与Docs的先后顺序 */}

      <h2 class='text-xl font-medium'>Docs</h2>
      <DocsContents title={false} horizontal />        {/* attention 发生了修改 */} {/* 横排 = flex-row + 换行 + 横向间距；竖排 = flex-col + 纵向间距。 */} {/* 传入了horizontal标签 让Docs的文档列表保持横排 */}

      <h2 class='text-xl font-medium'>Feedback</h2>
      <p>
        If you have any problems, you can open a <a
          href='https://github.com/Misaka13548/MisakaNetwork-Blog-in-Astro/issues'
          target='_blank'>Github Issue</a
      </p>
      <h2 class='text-xl font-medium'>News Describe (Alpha)</h2>
      <p>
        <a href='/docs/rss.xml' target='_blank'><Icon name='rss' /> </a>
      </p>
    </div>
  </main>
</PageLayout>
